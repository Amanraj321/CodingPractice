public class Main {
    public static void main(String[] args) {
        
        String str="aman";
       String result= IntStream.rangeClosed(1,str.length())
                        .mapToObj(i->str.charAt(str.length()-i))
                        .map(String::valueOf)
                        .collect(Collectors.joining());
        System.out.println("reversed string-->"+result);
        
        
        // StringBuilder result=new StringBuilder();
        // IntStream.iterate(str.length()-1,i->i>=0,i->i-1)
        //     .forEach(i->result.append(str.charAt(i)));
        // System.out.println("iterative way->"+result);
    }
}
