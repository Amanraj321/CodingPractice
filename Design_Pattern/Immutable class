
// Make the class final (so it can't be subclassed).
// Make all fields private and final.
// Don't provide setters — no way to modify fields.
// Initialize fields via constructor only.
// If a field is a mutable object (like a List), return a copy, not the original.
class Address{
    private String city;
    public Address(String city){
        this.city=city;
    }
    //copy contructor-used to do deep copy 
    public Address(Address other){
        this.city=other.city;
    }
    public String getCity(){
        return city;
    }
    public void setCity( String city){
        this.city=city;
    }
}
 final class Immutable{
private final  String name;
private Address address;
public Immutable(String name,Address address){
    this.name=name;
    this.address=new Address(address);
}
 public Address getAddress(){
     return new Address(address);
 }
}

public class Main{
    public static void main(String args[]){
       Address address= new Address("delhi");
       Immutable immutable= new Immutable("aman",address);
        address.setCity("bangalore");
       System.out.println( immutable.getAddress().getCity());
    }
}
//result delhi
