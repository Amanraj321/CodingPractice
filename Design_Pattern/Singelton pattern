//Lazy loading
         class Singleton {
            private static  Singleton instance;
        
            private Singleton() {
                // private constructor to prevent instantiation
            }
        
            public static  Singleton getInstance() {
                if (instance == null) {
                   instance= new Singleton(); // lazy initialization
                }
                return instance;
            }
        }
