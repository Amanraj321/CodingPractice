public class Main {
    static int getEquibliriumIndex(int[] arr){
        int leftSum=0;
        int totalSum=0;
            for(int i:arr){
                totalSum+=i;
            }
        for(int i=0;i<arr.length;i++){
            int rightSum=totalSum-leftSum-arr[i];
            if(leftSum==rightSum) return i;
            leftSum=leftSum+arr[i];
        }
        return -1;
    }
    
    public static void main(String[] args) {
        int[] arr={5,2,6,3,4};
        System.out.println("Equlibrium index ->"+getEquibliriumIndex(arr));
    }
}
//Equlibrium index ->2
