//If a number has any factor greater than its square root, it must also have a smaller one.
//2 is only even prime no

public class Main {
    public static boolean  isPrime(int n){
        if(n<=1) return false;
        if(n==2) return true;
        if(n%2==0) return false;
        for(int i=3;i<=Math.sqrt(n);i+=2){
            if(n%i==0) return false;
        }
        return true;
        
    }
    
    public static void  main(String[] args) {
        int number=2;
        int count=0;
       while (count<10){
           if(isPrime(number)){
               System.out.println(number);
               count++;
           }
            number++;
       }
        }
}

