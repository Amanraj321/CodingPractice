
// current != null → Checks if the current node exists. If current is null, it means we've reached the end of the list.
// current.next!= null →Checks if the current node is the last one,null means we have reached last node 

 class Node{
    int data;
    Node next;
    public Node(int data){
        this.data=data;
        this.next=null;
    }
}


public class Main {
 public static void middleElement( Node head){
     Node slow=head;
     Node fast=head;
     while(fast!=null && fast.next!=null && fast.next.next!=null){
         slow=slow.next;
         fast=fast.next.next;
     }
     if(fast!=null && fast.next !=null){
         System.out.println("even no "+slow.data+"-"+slow.next.data);
     }
     else{
          System.out.println("odd no "+slow.data);
     }
     //System.out.println(slow.data);
 }
 
    public static void  main(String[] args) {
        Node head = new Node(10);
        head.next = new Node(20);
        head.next.next = new Node(30);
        head.next.next.next = new Node(40);
        //head.next.next.next.next = new Node(50);
        
    middleElement(head);
        
    }   
}

