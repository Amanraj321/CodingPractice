
//if n is less<=1 retun same else return sum of two previous element



public class Main {
    
    public static int nthFib(int n){
        if(n<=1) return n;
        else return nthFib(n-1)+nthFib(n-2);
    }
    
    public static void  main(String[] args) {
        int count=0;
        while(count<10){
            System.out.println(nthFib(count));
            count++;
        }
    }   
}

//alternate way

public class Main {
    public static void printfib(int n){
        int first=0;
        int second=1;
        for(int i=0;i<n;i++){
            int next=first+second;
            System.out.println(next);
            first=second;
            second=next;
        }
    }  
    public static void  main(String[] args) {
       printfib(10);
        
    }   
}
