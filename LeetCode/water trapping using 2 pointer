
public class Main {
    
     public static int getData( int[] height){
         int left=0;
         int right=height.length-1;
         int lmax=0;int rmax=0;
             int total=0;
             while(left<right){
                 if(height[left]<height[right]){    //consider there is highest at right
                     if(height[left]>lmax){         //update lmax if height[L]>Lmax
                         lmax=height[left];
                     }
                     else                         //if fails means we have lmax,good to store water
                     {
                         total+=lmax-height[left];
                     }
                     left++;    
                 }
                 else
                 {
                      if(height[right]>rmax){
                         rmax=height[right];
                     }
                     else
                     {
                         total+=rmax-height[right];
                     }
                     right--; 
                 }
             }
         return total;
     }
    public static void main(String[] args) {
    int[] height={5,1,4};
        System.out.println(getData(height));
    }
}
