// "static void main" must be defined in a public class.
public class Main {
    
    public static int  getData(int[] height){
        int left=0;
        int right=height.length-1;
        int maxArea=0;
        while(left<right){
            if(height[left]<=height[right]){
                int tempArea=height[left]*(right-left);
                if(tempArea>maxArea){
                    maxArea=tempArea;
                }
                
                left++;
            }
            else{
                 int tempArea=height[right]*(right-left);
                if(tempArea>maxArea){
                    maxArea=tempArea;
                }
                right--;
            }
        }
        return maxArea;
    }
    public static void main(String[] args) {
        int[] height={2,4,3,5};
        System.out.println("max Araea-"+getData(height));
    }
}
